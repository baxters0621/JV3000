RewriteEngine On

# Exception: protected AJAX endpoints (usados por diseno.js y el dashboard).

RewriteRule ^includes/ajax/(alertas_ajax|clientes_buscar|productos_buscar)\.php$ - [L]

# Block internal directories and sensitive file types.

RewriteRule ^(?:backups|db|models|controllers|views|config|includes|core)(?:/|$) - [F,L,NC]

<FilesMatch "\.(?:sql|bat|inc)$">
Require all denied
</FilesMatch>
