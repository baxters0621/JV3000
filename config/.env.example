# Configuracion manual opcional; el asistente inicial puede guardar estos valores localmente.
# No pongas secretos en el repositorio.
JV_DB_HOST=localhost
JV_DB_USER=root
JV_DB_PASS=
JV_DB_NAME=jv3000_db
JV_DB_PORT=3306

# Credenciales del canal de correo para la recuperacion de contrasena por codigo.
# Son opcionales. Si se omiten, la comprobacion de red del canal de correo
# devuelve false y la aplicacion oculta el envio de codigo, dejando el PIN de
# emergencia como unico respaldo.
JV_SMTP_HOST=smtp.gmail.com
JV_SMTP_PORT=587
JV_SMTP_USER=
JV_SMTP_PASS=
JV_SMTP_FROM=
JV_SMTP_FROM_NAME=JV3000 C.A.
